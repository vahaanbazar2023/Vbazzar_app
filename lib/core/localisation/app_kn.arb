  "about": "ಕುರಿತು",
  "policy_title": "ಏಕೀಕೃತ ಬಳಕೆಯ ನಿಯಮಗಳು, ಗೌಪ್ಯತೆ ಮತ್ತು ಹರಾಜು ನೀತಿ",
  "policy_intro_text_1": "ಈ ದಸ್ತಾವೇಜು ನಮ್ಮ ವಾಹನ ಹರಾಜು ವೇದಿಕೆ ಮತ್ತು ಸಂಬಂಧಿತ ಸೇವೆಗಳ (\"ವೇದಿಕೆ\") ನಿಮ್ಮ ಬಳಕೆಯನ್ನು ನಿಯಂತ್ರಿಸುತ್ತದೆ.",
  "policy_intro_text_2": "ಇದು ಎಲ್ಲಾ ಬಳಕೆದಾರರಿಗೆ (\"ಖರೀದಿದಾರರು\" ಮತ್ತು \"ಮಾರಾಟಗಾರರು\") ಬಳಕೆಯ ನಿಯಮಗಳು, ಗೌಪ್ಯತಾ ನೀತಿಗಳು ಮತ್ತು ಹರಾಜು ಕಾರ್ಯವಿಧಾನಗಳನ್ನು ಒಟ್ಟುಗೂಡಿಸುತ್ತದೆ.",
  "section_1_heading": "1. ಕಾನೂನು ಸೂಚನೆ",
  "section_1_text_1": "ಇದು ಮಾಹಿತಿ ತಂತ್ರಜ್ಞಾನ ಕಾಯ್ದೆ, 2000 ರ ಪ್ರಕಾರ ವಿದ್ಯುನ್ಮಾನ ದಾಖಲೆಯಾಗಿದೆ.",
  "section_1_text_2": "ವೇದಿಕೆಯ ಬಳಕೆಯು ಈ ನಿಯಮಗಳಿಗೆ ನಿಮ್ಮ ಒಪ್ಪಿಗೆಯನ್ನು ದೃಢೀಕರಿಸುತ್ತದೆ.",
  "section_2_heading": "2. ವ್ಯಾಖ್ಯಾನಗಳು",
  "definition_user": "• ಬಳಕೆದಾರ: ವೇದಿಕೆಯಲ್ಲಿ ನೋಂದಾಯಿತ ಯಾವುದೇ ವ್ಯಕ್ತಿ ಅಥವಾ ಸಂಸ್ಥೆ.",
  "definition_auction_buyer": "• ಹರಾಜು ಖರೀದಿದಾರ: ವಾಹನಗಳ ಮೇಲೆ ಬಿಡ್ ಸಲ್ಲಿಸುವ ಯಾವುದೇ ವ್ಯಕ್ತಿ ಅಥವಾ ವ್ಯವಹಾರ.",
  "definition_seller": "• ಮಾರಾಟಗಾರ: ಹರಾಜಿಗಾಗಿ ವಾಹನಗಳನ್ನು ಪಟ್ಟಿ ಮಾಡುವ ಯಾವುದೇ ವ್ಯಕ್ತಿ ಅಥವಾ ವ್ಯವಹಾರ.",
  "definition_platform": "• ವೇದಿಕೆ: ಆನ್‌ಲೈನ್ ವಾಹನ ಹರಾಜುಗಳನ್ನು ಸುಗಮಗೊಳಿಸುವ ಡಿಜಿಟಲ್ ಇಂಟರ್ಫೇಸ್ (ವೆಬ್‌ಸೈಟ್/ಆ್ಯಪ್). ಅಂದರೆ ವಾಹನ್ ಬಜಾರ್ ಪ್ರೈವೇಟ್ ಲಿಮಿಟೆಡ್.",
  "section_3_heading": "3. ಅರ್ಹತೆ ಮತ್ತು ನೋಂದಣಿ",
  "eligibility_text_1": "• ಬಳಕೆದಾರರು 18 ವರ್ಷ ಅಥವಾ ಹೆಚ್ಚಿನ ವಯಸ್ಸಿನವರಾಗಿರಬೇಕು.",
  "eligibility_text_2": "• ವ್ಯಾಪಾರ ಬಳಕೆದಾರರು ತಮ್ಮ ಸಂಸ್ಥೆಯನ್ನು ಪ್ರತಿನಿಧಿಸಲು ಅಧಿಕೃತರಾಗಿರಬೇಕು.",
  "eligibility_text_3": "• ನಿಖರವಾದ, ನವೀಕರಿಸಿದ ನೋಂದಣಿ ವಿವರಗಳು ಕಡ್ಡಾಯ.",
  "eligibility_text_4": "• ತನ್ನ ವಿವೇಚನೆಯಂತೆ ಪ್ರವೇಶವನ್ನು ನಿರಾಕರಿಸುವ ಅಥವಾ ಕೊನೆಗೊಳಿಸುವ ಹಕ್ಕನ್ನು ವೇದಿಕೆ ಕಾಯ್ದಿರಿಸಿಕೊಂಡಿದೆ.",
  "section_4_heading": "4. ಖಾತೆ ಜವಾಬ್ದಾರಿಗಳು",
  "account_responsibility_text_1": "• ಲಾಗಿನ್ ರುಜುವಾತುಗಳನ್ನು ಸುರಕ್ಷಿತವಾಗಿಡಿ.",
  "account_responsibility_text_2": "• ನಿರ್ಬಂಧಗಳನ್ನು ತಪ್ಪಿಸಲು ಬಹು ಖಾತೆಗಳನ್ನು ರಚಿಸಬೇಡಿ.",
  "account_responsibility_text_3": "• ತಮ್ಮ ನೋಂದಾಯಿತ ಐಡಿ ಅಡಿಯಲ್ಲಿ ನಡೆಯುವ ಎಲ್ಲಾ ಚಟುವಟಿಕೆಗಳಿಗೆ ಬಳಕೆದಾರರೇ ಜವಾಬ್ದಾರರು.",
  "section_5_heading": "5. ಗೌಪ್ಯತಾ ನೀತಿ",
  "privacy_policy_intro": "ನಾವು ಈ ಬಳಕೆದಾರ ಡೇಟಾವನ್ನು ಸಂಗ್ರಹಿಸಿ ಸಂಸ್ಕರಿಸುತ್ತೇವೆ:",
  "privacy_data_collected_1": "• ಹೆಸರು, ಸಂಪರ್ಕ ವಿವರಗಳು, ಬ್ರೌಸಿಂಗ್ ಇತಿಹಾಸ, ಪಾವತಿ ದಾಖಲೆಗಳು.",
  "privacy_data_used_for": "• ಸೇವೆಗಳನ್ನು ಒದಗಿಸಲು, ವಿಷಯವನ್ನು ವೈಯಕ್ತೀಕರಿಸಲು, ವಂಚನೆ ಪತ್ತೆಹಚ್ಚಲು ಮತ್ತು ಭದ್ರತೆಯನ್ನು ಸುಧಾರಿಸಲು ಬಳಸಲಾಗುತ್ತದೆ.",
  "privacy_user_rights": "• ಬೆಂಬಲವನ್ನು ಸಂಪರ್ಕಿಸುವ ಮೂಲಕ ತಮ್ಮ ಡೇಟಾವನ್ನು ಪ್ರವೇಶಿಸಲು, ನವೀಕರಿಸಲು ಅಥವಾ ಅಳಿಸಲು ಬಳಕೆದಾರರಿಗೆ ಹಕ್ಕಿದೆ.",
  "section_6_heading": "6. ವೇದಿಕೆಯ ಬಳಕೆ",
  "use_platform_text_1": "• ವೇದಿಕೆಯು ವಹಿವಾಟುಗಳನ್ನು ಸುಗಮಗೊಳಿಸುತ್ತದೆ; ಇದು ಮಾರಾಟ ಒಪ್ಪಂದದ ಪಕ್ಷವಲ್ಲ.",
  "use_platform_text_2": "• ಖರೀದಿದಾರರು ವಾಹನಗಳನ್ನು ಸ್ವತಂತ್ರವಾಗಿ ಪರಿಶೀಲಿಸಿ ಮಾಹಿತಿಯನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಬೇಕು.",
  "use_platform_text_3": "• ಎಲ್ಲಾ ಪಟ್ಟಿಗಳು ಕಟ್ಟುನಿಟ್ಟಾಗಿ \"ಇರುವ ಸ್ಥಿತಿಯಲ್ಲಿ, ಇರುವ ಸ್ಥಳದಲ್ಲಿ\" ಆಧಾರದ ಮೇಲೆ ಇರುತ್ತವೆ.",
  "section_7_heading": "7. ಹರಾಜು ಮತ್ತು ಬಿಡ್ಡಿಂಗ್ ನಿಯಮಗಳು",
  "bidding_rules_text_1": "• ಎಲ್ಲಾ ಬಿಡ್‌ಗಳು ಕಾನೂನುಬದ್ಧವಾಗಿ ಬದ್ಧವಾಗಿರುತ್ತವೆ.",
  "bidding_rules_text_2": "• ಅತ್ಯಧಿಕ ಬಿಡ್ (ಬೆಲೆ + ಮೊದಲ ಸಮಯ) ಮಾನ್ಯವಾಗುತ್ತದೆ.",
  "bidding_rules_text_3": "• ಸಂಶಯಾಸ್ಪದವೆಂದು ಕಂಡುಬಂದರೆ ಬಿಡ್‌ಗಳನ್ನು ತಿರಸ್ಕರಿಸಬಹುದು.",
  "bidding_rules_text_4": "• ಮಾರಾಟ ಸ್ವೀಕಾರದ ಬಗ್ಗೆ ಅಂತಿಮ ವಿವೇಚನೆ ಮಾರಾಟಗಾರರದ್ದಾಗಿದೆ.",
  "section_8_heading": "8. ವಾಹನ ಪರಿಶೀಲನೆ",
  "vehicle_inspection_text_1": "• ವಾಹನ ಸ್ಥಿತಿಯ ಪ್ರಮಾಣೀಕರಣಗಳು ಸೂಚಕ ಮಾತ್ರ.",
  "vehicle_inspection_text_2": "• ಖರೀದಿದಾರರು ವಾಹನಗಳನ್ನು ತಾವೇ ಪರಿಶೀಲಿಸಿ ಬಾಧ್ಯತೆಗಳನ್ನು (ತೆರಿಗೆ, ದಂಡ ಇತ್ಯಾದಿ) ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಬೇಕು.",
  "vehicle_inspection_text_3": "• ಪಟ್ಟಿಯ ನಿಖರತೆಗೆ ವೇದಿಕೆ ಖಾತರಿ ನೀಡುವುದಿಲ್ಲ.",
  "section_9_heading": "9. ಪಾವತಿಗಳು",
  "payments_text_1": "• ನಿಗದಿತ ಸಮಯದೊಳಗೆ ಪಾವತಿ ಮಾಡಬೇಕು (ಉದಾ., 5–7 ಕೆಲಸದ ದಿನಗಳು).",
  "payments_text_2": "• ಖರೀದಿದಾರರು ಅನ್ವಯವಾಗುವ ತೆರಿಗೆಗಳು, ಪಾರ್ಕಿಂಗ್ ಶುಲ್ಕಗಳು ಮತ್ತು RTO/GST/TCS ಬಾಕಿಗಳನ್ನು ಪಾವತಿಸಬೇಕು.",
  "payments_text_3": "• ಪಾವತಿ ಮಾಡದಿದ್ದರೆ ಮುಟ್ಟುಗೋಲು ಅಥವಾ ಕಾನೂನು ಕ್ರಮಕ್ಕೆ ಕಾರಣವಾಗಬಹುದು.",
  "section_10_heading": "10. ಮಾಲೀಕತ್ವ ವರ್ಗಾವಣೆ",
  "ownership_transfer_text_1": "• NOC/TTO ನೀಡಿದ 60 ದಿನಗಳೊಳಗೆ ಖರೀದಿದಾರರು ಮಾಲೀಕತ್ವವನ್ನು ವರ್ಗಾಯಿಸಬೇಕು.",
  "ownership_transfer_text_2": "• ಪಾಲಿಸದಿದ್ದರೆ ಖಾತೆ ನಿರ್ಬಂಧಿಸಲ್ಪಡಬಹುದು.",
  "ownership_transfer_text_3": "• ವಾಹನ ಬಿಡುಗಡೆಗೆ ತೆರಿಗೆ ರಸೀದಿಗಳು ಅಗತ್ಯವಾಗಬಹುದು.",
  "section_11_heading": "11. ನಷ್ಟಪರಿಹಾರ",
  "indemnity_intro": "ಈ ಕಾರಣಗಳಿಂದ ಉಂಟಾಗುವ ಎಲ್ಲಾ ಕ್ಲೈಮ್‌ಗಳು, ದಂಡಗಳು ಅಥವಾ ಹೊಣೆಗಾರಿಕೆಗಳಿಂದ ವೇದಿಕೆಗೆ ನಷ್ಟಪರಿಹಾರ ನೀಡಲು ಬಳಕೆದಾರರು ಒಪ್ಪುತ್ತಾರೆ:",
  "indemnity_item_1": "• ನಿಯಮಗಳ ಉಲ್ಲಂಘನೆ",
  "indemnity_item_2": "• ಕಾನೂನು ಉಲ್ಲಂಘನೆಗಳು",
  "indemnity_item_3": "• ಮಾರಾಟದ ನಂತರ ವಾಹನಗಳ ದುರುಪಯೋಗ",
  "section_12_heading": "12. ಹೊಣೆಗಾರಿಕೆಯ ಮಿತಿ",
  "limitation_liability_text_1": "• ಸೇವೆಗಳನ್ನು \"ಇರುವಂತೆಯೇ\" ಒದಗಿಸಲಾಗುತ್ತದೆ.",
  "limitation_liability_text_2": "• ವಿಳಂಬ, ವೈಫಲ್ಯ ಅಥವಾ ಪಟ್ಟಿಯ ತಪ್ಪುಗಳಿಗೆ ವೇದಿಕೆ ಹೊಣೆಯಲ್ಲ.",
  "limitation_liability_text_3": "• ಗರಿಷ್ಠ ಹೊಣೆಗಾರಿಕೆಯು ವೇದಿಕೆಗೆ ಪಾವತಿಸಿದ ಯಾವುದೇ ಸೇವಾ ಶುಲ್ಕಕ್ಕೆ ಸೀಮಿತವಾಗಿದೆ.",
  "section_13_heading": "13. ಬೌದ್ಧಿಕ ಆಸ್ತಿ",
  "intellectual_property_text": "ವೇದಿಕೆಯ ಎಲ್ಲಾ ವಿಷಯ (ಪಠ್ಯ, ದೃಶ್ಯಗಳು, ಸಾಧನಗಳು) ಬೌದ್ಧಿಕ ಆಸ್ತಿಯಾಗಿ ರಕ್ಷಿತವಾಗಿದೆ. ಯಾವುದೇ ಪುನರುತ್ಪಾದನೆ, ವಿತರಣೆ ಅಥವಾ ಅನಧಿಕೃತ ಬಳಕೆಗೆ ಅನುಮತಿ ಇಲ್ಲ.",
  "section_14_heading": "14. ವಿವಾದ ಪರಿಹಾರ",
  "dispute_resolution_text_1": "• ಈ ಒಪ್ಪಂದವು ಭಾರತೀಯ ಕಾನೂನಿನಿಂದ ನಿಯಂತ್ರಿಸಲ್ಪಡುತ್ತದೆ.",
  "dispute_resolution_text_2": "• ಮಧ್ಯಸ್ಥಿಕೆ ಮತ್ತು ಸಂಧಾನ ಕಾಯ್ದೆ, 1996 ರ ಅಡಿಯಲ್ಲಿ ಹೈದರಾಬಾದ್‌ನಲ್ಲಿ ಮಧ್ಯಸ್ಥಿಕೆ ನಡೆಸಲಾಗುತ್ತದೆ.",
  "dispute_resolution_text_3": "• ಬೇರೆ ರೀತಿ ಸೂಚಿಸದ ಹೊರತು ಪ್ರತಿ ಪಕ್ಷವೂ ತನ್ನ ಕಾನೂನು ವೆಚ್ಚಗಳನ್ನು ಭರಿಸುತ್ತದೆ.",
  "section_15_heading": "15. ಸೂಚನೆಗಳು",
  "notices_text_1": "• ಅಧಿಕೃತ ಸಂವಹನವನ್ನು ನೋಂದಾಯಿತ ಅಂಚೆ ಅಥವಾ ಇಮೇಲ್ ಮೂಲಕ ಮಾಡಲಾಗುತ್ತದೆ.",
  "notices_text_2": "• ಬಳಕೆದಾರರು ತಮ್ಮ ಸಂಪರ್ಕ ಮಾಹಿತಿಯನ್ನು ನವೀಕರಿಸಿಟ್ಟುಕೊಳ್ಳಬೇಕು.",
  "policy_acknowledgement": "ವೇದಿಕೆಯನ್ನು ಬಳಸುವುದನ್ನು ಮುಂದುವರಿಸುವ ಮೂಲಕ, ವಾಹನ್ ಬಜಾರ್ ಪ್ರೈವೇಟ್ ಲಿಮಿಟೆಡ್‌ನ ಈ ಏಕೀಕೃತ ನಿಯಮಗಳನ್ನು ನೀವು ಓದಿದ್ದೀರಿ, ಅರ್ಥಮಾಡಿಕೊಂಡಿದ್ದೀರಿ ಮತ್ತು ಒಪ್ಪಿದ್ದೀರಿ ಎಂದು ಒಪ್ಪಿಕೊಳ್ಳುತ್ತೀರಿ.",
