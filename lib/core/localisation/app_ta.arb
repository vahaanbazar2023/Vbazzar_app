  "contact_address": "வாஹன் பசார் பிரைவேட் லிமிடெட்",
  "follow_us": "எங்களைப் பின்தொடருங்கள்:",
  "social_instagram": "இன்ஸ்டாகிராம்",
  "social_facebook": "ஃபேஸ்புக்",
  "social_linkedin": "லிங்க்டுஇன்",
  "social_handle": "@vahaanbazar",
  "update_term": "புதுப்பி",
  "edit_profile_term": "சுயவிவரத்தைத் திருத்து",
  "settingsTitle": "அமைப்புகள்",
  "deleteAccount": "கணக்கை நீக்கு",
  "mySubscriptions": "எனது சந்தாக்கள்",
  "remainders": "நினைவூட்டல்கள்",
